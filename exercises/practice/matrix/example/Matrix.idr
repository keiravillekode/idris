module Matrix

import Data.String

export
row : String -> Nat -> String
row str index = split (== '\n') str

list_lookup n xs


split by '\n'
take (index - 1 ) entry
split by space
map convert to int

export
column : String -> Nat -> String
column str index = ?column_rhs

split by '\n'
map over each:

split by space
take (index - 1 ) entry
convert to int
